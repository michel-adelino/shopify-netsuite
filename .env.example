# ----- Shopify -----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
SHOPIFY_WEBHOOK_SECRET=whsec_xxx
SHOPIFY_API_VERSION=2024-10

# ----- NetSuite -----
# Use either TBA or OAuth 2.0, not both. Leave the unused block empty.
NETSUITE_ACCOUNT_ID=1234567
NETSUITE_BASE_URL=https://1234567.suitetalk.api.netsuite.com

# Token Based Authentication (legacy, still supported)
NETSUITE_TBA_CONSUMER_KEY=
NETSUITE_TBA_CONSUMER_SECRET=
NETSUITE_TBA_TOKEN_ID=
NETSUITE_TBA_TOKEN_SECRET=

# OAuth 2.0 machine-to-machine (preferred for new tenants)
NETSUITE_OAUTH2_CLIENT_ID=
NETSUITE_OAUTH2_CERTIFICATE_ID=
NETSUITE_OAUTH2_PRIVATE_KEY_PATH=./secrets/netsuite-private.pem

# ----- Subsidiary and channel mapping -----
NETSUITE_SUBSIDIARY_ID=1
NETSUITE_SHOPIFY_CHANNEL_CLASS_ID=12
NETSUITE_DEFAULT_CUSTOMER_INTERNAL_ID=

# ----- Queue backend -----
# Options: redis | sqs | gcp-tasks | inline (dev only)
QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379
SQS_QUEUE_URL=
GCP_TASKS_QUEUE=

# ----- FX rate provider (optional) -----
FX_PROVIDER=openexchangerates
FX_API_KEY=

# ----- Server -----
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
